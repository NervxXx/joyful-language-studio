# =============================================================================
# English Studio — переменные окружения
# Скопируйте в .env и заполните своими значения. Файл .env не коммитить.
# =============================================================================

# --- PostgreSQL ---
DB_NAME=english_studio
DB_USER=english_studio_user
DB_PASSWORD=задайте_надёжный_пароль

# --- Backend (обязательно) ---
SECRET_KEY=сгенерируйте_64_символа_python_c_import_secrets_print_secrets_token_urlsafe_64
DATABASE_URL=postgresql://english_studio_user:пароль@localhost:5432/english_studio

# --- Redis (опционально, для rate limiting; без Redis работает in-memory) ---
REDIS_URL=redis://localhost:6379/0

# --- Backend (опционально) ---
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- OpenRouter API (для AI Coach в чате) ---
OPENROUTER_API_KEY=sk-or-v1-...

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Google OAuth (опционально) ---
GOOGLE_CLIENT_ID=ваш_client_id.apps.googleusercontent.com
# GOOGLE_ADDITIONAL_CLIENT_IDS=другой_client_id.apps.googleusercontent.com

# --- Cookies ---
# COOKIE_SECURE=true
# COOKIE_SAMESITE=none

# --- Dev ---
DEBUG=True
PORT=8000

# --- Frontend (Vite, для production) ---
# VITE_API_BASE_URL=http://localhost:8000
